{
  "name": "@opita/vibe-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime de tools componibles para Opita Code. Contratos son datos; la magia es codigo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "mutate": "npm run build && node tools/mutation/run.mjs",
    "budget": "node tools/gate-budget.mjs",
    "content": "node tools/content-guard.mjs",
    "generar-estado": "node scripts/generar-estado.mjs",
    "verificar-estado": "node scripts/verificar-estado.mjs",
    "check": "npm run content && npm run budget && npm run test && npm run mutate",
    "generar-sitio": "node scripts/generar-sitio.mjs",
    "preview": "node tools/render-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2"
  }
}
